{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(actionlint *)",
      "Bash(bun list *)",
      "Bash(find *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status *)",
      "Bash(gh pr view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh search *)",
      "Bash(ghalint *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(go doc *)",
      "Bash(go fmt *)",
      "Bash(go list *)",
      "Bash(go vet *)",
      "Bash(gofmt *)",
      "Bash(goimports *)",
      "Bash(golangci-lint run *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(npm info *)",
      "Bash(npx ctx7@latest *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(test *)",
      "Bash(wc *)",
      "Bash(zizmor *)",
      "WebSearch",
      "WebFetch",
      "Skill(frontend-design)",
      "Skill(validate-plan)"
    ],
    "deny": [
      "Bash(gh repo archive *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo unarchive *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(bun publish *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(keeper *)",
      "Edit(~/.zshrc)",
      "Read(.env*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Bash(git add .)",
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(git push *)",
      "Bash(sudo rm *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf .git)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/mask-secrets.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e \"display notification \\\"$(jq -r '.message')\\\" with title \\\"Claude Code\\\" sound name \\\"Funk\\\"\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.ts"
  },
  "extraKnownMarketplaces": {
    "swampman": {
      "source": {
        "source": "github",
        "repo": "koki-develop/swampman"
      }
    }
  },
  "language": "Japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowLocalBinding": true
    },
    "ignoreViolations": {
      "Bash": [
        "expansion-obfuscation",
        "potential-obfuscation"
      ]
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "enableWorkflows": true
}
