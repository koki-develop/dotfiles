{
  "attribution": {
    "sessionUrl": false
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status *)",
      "Bash(gh pr view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh search *)",
      "Bash(git fetch *)",
      "Bash(npm info *)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(gh repo archive *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo unarchive *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(bun publish *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(keeper *)",
      "Edit(~/.zshrc)",
      "Read(.env*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Bash(git add .)",
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(sudo rm *)",
      "Bash(security *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf .git)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-tmpdir.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/mask-secrets.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e \"display notification \\\"$(jq -r '.message')\\\" with title \\\"Claude Code\\\" sound name \\\"Funk\\\"\""
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.ts"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "swampman@swampman": true
  },
  "extraKnownMarketplaces": {
    "swampman": {
      "source": {
        "source": "github",
        "repo": "koki-develop/swampman"
      }
    }
  },
  "language": "Japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["gh *"],
    "network": {
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": ["~/.npm", "~/.opensrc", "~/Library/Caches/go-build"]
    },
    "ignoreViolations": {
      "Bash": ["expansion-obfuscation", "potential-obfuscation"]
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true
}
