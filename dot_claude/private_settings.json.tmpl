{
  "remoteControlAtStartup": true,
  "attribution": {
    "sessionUrl": false
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "NODE_USE_ENV_PROXY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git fetch *)",
      "Bash(gh auth status)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status *)",
      "Bash(gh pr view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh search *)",

      "Bash(betterleaks *)",
      "Bash(npm info *)",
      "Bash(opensrc *)",

      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(gh issue create *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo unarchive *)",

      "Bash(bun publish *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",

      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",

      "Bash(env *)",
      "Bash(gh auth token *)",
      "Bash(gh secret set *)",
      "Bash(gh variable set *)",
      "Bash(keeper *)",
      "Bash(printenv *)",
      "Bash(security *)",
      "Read(.env*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.zshrc)",

      "Bash(chezmoi destroy *)",
      "Bash(chezmoi forget *)",
      "Bash(git add .)",
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(git stash *)",
      "Bash(rm -rf .git)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(sudo rm *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-tmpdir.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/mask-secrets.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.ts"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "language": "Japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["gh *"],
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": ["npm.flatt.tech", "context7.com", "*.context7.com"]
    },
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.opensrc",
        "~/.gotrash",
        "~/Library/Caches/go-build"
      ]
    },
    "ignoreViolations": {
      "Bash": ["expansion-obfuscation", "potential-obfuscation"]
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "ghostty",
  "agentPushNotifEnabled": true
}
